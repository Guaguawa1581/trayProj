{
  "Gateway": {
    "WebRoot": "../../frontend/dist"
  },
  "ReverseProxy": {
    "Routes": {
      "main-api": {
        "ClusterId": "main-api",
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": {
      "main-api": {
        "Destinations": {
          "primary": { "Address": "http://127.0.0.1:5100/" }
        }
      }
    }
  }
}
